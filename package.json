{
  "name": "njc-bible-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/rasterize-icons.mjs",
    "prepare:tamil": "node scripts/prepare-tamil-ov.mjs",
    "prepare:tanglish": "node scripts/prepare-tanglish.mjs",
    "prepare:thngv": "node scripts/prepare-thngv.mjs",
    "prepare:strongs": "python scripts/prepare-strongs.py",
    "prepare:commentary": "python scripts/prepare-commentary.py",
    "apk": "bubblewrap update --manifest android-twa && bubblewrap build --skipPwaValidation --manifest android-twa"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/noto-sans-tamil": "^5.2.6",
    "@fontsource/noto-serif-tamil": "^5.2.6",
    "@fontsource/source-serif-4": "^5.2.8",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "firebase": "^12.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
